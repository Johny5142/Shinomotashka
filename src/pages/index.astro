---
import { asc, eq } from "drizzle-orm";
import Layout from "../layouts/Layout.astro";
import { db } from "../server/db";
import { services, settings } from "../server/schema";
import { demoMode } from "../server/demo";
const [shop] = await db.select().from(settings).where(eq(settings.id, 1));
if (!shop) throw new Error("Run database migrations");
const items = await db.select().from(services).orderBy(asc(services.position));
const packages = items.filter((s) => s.category === "package");
const extras = items.filter((s) => s.category === "extra");
const money = (value: number) =>
  new Intl.NumberFormat("ru-RU").format(value / 100);
const demo = demoMode();
const phoneHref = `tel:${shop.phone.replace(/[^+\d]/g, "")}`;
---

<Layout title={`${shop.name} — шиномонтаж, ${shop.city}`} demo={demo}>
  {demo && (
    <div class="demo-bar">
      Демонстрационный сайт · мастерская и цены вымышлены{" "}
      <a href="/admin">Попробовать админку ↗</a>
    </div>
  )}
  <header class="header wrap">
    <a class="brand" href="/" aria-label={`${shop.name} — главная`}>
      <span class="brand-icon" aria-hidden="true">
        ◉
      </span>
      <span>
        {shop.name}
        <small>ШИНОМОНТАЖ · {shop.city.toUpperCase()}</small>
      </span>
    </a>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="navigation"
    >
      Меню
    </button>
    <nav id="navigation" aria-label="Основная навигация">
      <a href="#prices">Цены</a>
      <a href="#services">Услуги</a>
      <a href="#questions">Вопросы</a>
      <a href="#contacts">Как нас найти</a>
    </nav>
    <a class="header-cta" href="#request">
      Оставить заявку <span aria-hidden="true">↗</span>
    </a>
  </header>
  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span> {shop.city} · {shop.hours}
        </p>
        <h1>
          Пора менять
          <br />
          шины.
          <br />
          <span>Всё по делу.</span>
        </h1>
        <p class="hero-description">
          Сезонная замена колёс, балансировка и ремонт проколов. Выберите услугу
          — согласуем время и стоимость до начала работ.
        </p>
        <div class="actions">
          <a class="button" href="#prices">
            Посмотреть цены <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="#request">
            Связаться с мастером ↗
          </a>
        </div>
        <div class="hero-foot">
          <span>Легковые автомобили</span>
          <span>R13–R20</span>
        </div>
      </div>
      <figure class="hero-photo">
        <img
          src="/images/workshop.webp"
          alt="Мастер устанавливает колесо в шиномонтажной мастерской"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <figcaption>
          <span>Внимание к каждому колесу</span>
          <span aria-hidden="true">↗</span>
        </figcaption>
      </figure>
    </section>
    <div class="service-strip">
      <div class="wrap">
        <span>Сезонная замена</span>
        <span>Балансировка</span>
        <span>Ремонт проколов</span>
        <span>Замена вентилей</span>
      </div>
    </div>
    <section id="prices" class="section wrap price-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ПОНЯТНАЯ СТОИМОСТЬ</p>
          <h2>
            Четыре колеса.
            <br />
            Один комплект работ.
          </h2>
        </div>
        <p>
          Выберите диаметр колёс.
          <br />
          {demo
            ? "Цены приведены для демонстрации."
            : "Для легковых автомобилей. Итог согласуем после осмотра."}
        </p>
      </div>
      <div class="price-grid">
        {packages.map((item, index) => (
          <article class:list={["price-card", { featured: index === 1 }]}>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <div class="price">
              {money(item.price)} <span>₽</span>
            </div>
            <a href="#request" class="price-link" data-service={item.id}>
              Оставить заявку <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
      <div class="included">
        <strong>Что входит в стоимость</strong>
        <p>{shop.included}</p>
      </div>
    </section>
    <section id="services" class="section services-section">
      <div class="wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">КОГДА НУЖНО БОЛЬШЕ</p>
            <h2>Поможем с колесом</h2>
          </div>
          <p>
            Осмотрим повреждение и предложим
            <br />
            подходящий способ ремонта.
          </p>
        </div>
        <div class="extra-list">
          {extras.map((item) => (
            <a href="#request" data-service={item.id} class="extra-row">
              <div>
                <h3>{item.name}</h3>
                <p>{item.description}</p>
              </div>
              <strong>
                от {money(item.price)} ₽ <span aria-hidden="true">↗</span>
              </strong>
            </a>
          ))}
        </div>
      </div>
    </section>
    <section class="section wrap process">
      <div>
        <p class="eyebrow">БЕЗ ЛИШНИХ ХЛОПОТ</p>
        <h2>
          От заявки
          <br />
          до готовых колёс
        </h2>
        <a class="text-link" href="#request">
          Договориться о времени ↗
        </a>
      </div>
      <ol>
        <li>
          <h3>Согласуем время</h3>
          <p>
            Оставьте номер. Уточним автомобиль, диаметр колёс и удобное время
            приезда.
          </p>
        </li>
        <li>
          <h3>Осмотрим и назовём цену</h3>
          <p>
            Проверим шины и диски, обсудим объём работ и дополнительные расходы.
          </p>
        </li>
        <li>
          <h3>Выполним работу</h3>
          <p>Заменим шины, отбалансируем колёса и проверим давление.</p>
        </li>
      </ol>
    </section>
    <section id="questions" class="section wrap faq">
      <div>
        <p class="eyebrow">ПЕРЕД ПРИЕЗДОМ</p>
        <h2>Частые вопросы</h2>
      </div>
      <div>
        <details>
          <summary>Можно приехать со своими шинами?</summary>
          <p>
            Да. При обращении уточните размер и состояние шин, а также
            установлены ли они на дисках.
          </p>
        </details>
        <details>
          <summary>Как узнать полную стоимость?</summary>
          <p>
            Сообщите модель автомобиля, диаметр колёс и нужную услугу. После
            осмотра мастер согласует итоговую стоимость до начала работ.
          </p>
        </details>
        <details>
          <summary>Работаете с RunFlat и внедорожниками?</summary>
          <p>
            Возможность обслуживания и цену таких колёс нужно отдельно
            согласовать с мастером до приезда.
          </p>
        </details>
        <details>
          <summary>Заявка — это запись на конкретное время?</summary>
          <p>
            Это просьба связаться с вами. Время приезда подтверждает мастер
            после обращения.
          </p>
        </details>
      </div>
    </section>
    <section id="request" class="section request-section">
      <div class="wrap request-grid">
        <div>
          <p class="eyebrow">ДОГОВОРИМСЯ О ПРИЕЗДЕ</p>
          <h2>
            Оставьте номер.
            <br />
            Обсудим детали.
          </h2>
          <p>
            {demo
              ? "Попробуйте отправить тестовую заявку, а затем найдите её в демоадминке. Используйте вымышленные данные."
              : "Мастер уточнит задачу и согласует удобное время."}
          </p>
          {demo && (
            <a class="text-link" href="/admin">
              Открыть демоадминку ↗
            </a>
          )}
        </div>
        <form id="lead-form">
          <div class="form-row">
            <label>
              Ваше имя
              <input
                name="name"
                autocomplete="given-name"
                required
                maxlength="80"
                placeholder="Как к вам обращаться"
              />
            </label>
            <label>
              Телефон
              <input
                name="phone"
                type="tel"
                autocomplete="tel"
                required
                maxlength="32"
                placeholder="+7 ___ ___-__-__"
              />
            </label>
          </div>
          <label>
            Услуга
            <select name="serviceId" required>
              <option value="">Выберите услугу</option>
              {items.map((item) => (
                <option value={item.id}>
                  {item.name}
                  {item.category === "package" ? " · замена комплекта" : ""}
                </option>
              ))}
            </select>
          </label>
          <label>
            Комментарий <span class="optional">необязательно</span>
            <textarea
              name="comment"
              rows="3"
              maxlength="1000"
              placeholder="Модель автомобиля, размер колёс или ваш вопрос"
            ></textarea>
          </label>
          <button class="button" type="submit">
            {demo ? "Отправить тестовую заявку" : "Отправить заявку"}{" "}
            <span aria-hidden="true">↗</span>
          </button>
          <p class="form-note">
            {demo
              ? "Это демонстрация. Изменения и тестовые заявки сбрасываются раз в сутки."
              : "Отправляя заявку, вы разрешаете связаться с вами по указанному номеру для обсуждения услуги."}
          </p>
          <p id="lead-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
    <section id="contacts" class="section wrap contact-grid">
      <div>
        <p class="eyebrow">НА СВЯЗИ</p>
        <h2>Ждём ваши колёса</h2>
        <p class="contact-address">
          {shop.city}
          <br />
          {shop.address}
        </p>
        <p>{shop.hours}</p>
        {shop.phone ? (
          <a class="contact-phone" href={phoneHref}>
            {shop.phone}
          </a>
        ) : (
          <p class="contact-phone">Здесь будет телефон мастерской</p>
        )}
        <a
          class="text-link"
          href={`https://yandex.ru/maps/?text=${encodeURIComponent(demo ? shop.city : `${shop.city}, ${shop.address}`)}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {demo ? "Открыть город на карте" : "Показать на карте"} ↗
        </a>
      </div>
      <div class="contact-panel">
        <span class="brand-icon" aria-hidden="true">
          ◉
        </span>
        <h3>{shop.name}</h3>
        <p>
          {demo
            ? "Ваши услуги, цены и контакты — на одном сайте. Владелец меняет информацию в кабинете."
            : "Уточните время приезда перед визитом."}
        </p>
        <a class="button secondary" href={demo ? "/admin" : "#request"}>
          {demo ? "Попробовать кабинет владельца" : "Оставить заявку"} ↗
        </a>
      </div>
    </section>
  </main>
  <footer class="wrap footer">
    <a class="brand" href="/">
      ◉ {shop.name}
    </a>
    <span>
      {demo ? "Демонстрационный проект" : `Шиномонтаж · ${shop.city}`}
    </span>
    <a href="/admin">Кабинет владельца ↗</a>
  </footer>
  <a href="#request" class="mobile-cta">
    Оставить заявку ↗
  </a>
  <script src="../scripts/public.ts"></script>
</Layout>
